@@ -0,0 +1,94 @@
+//! Streams the selected microphone to the selected output during a local test.
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+        mpsc,
+    },
+    time::Duration,
+};
+
+use anyhow::{Context, Result};
+
+use crate::audio_io::{Input, Output, RATE};
+
+const CHUNK: usize = RATE as usize / 50;
+
+pub enum Status {
+    Monitoring,
+    Failed(String),
+}
+
+pub struct Test {
+    pub status: mpsc::Receiver<Status>,
+    pub microphone: Option<String>,
+    pub speaker: Option<String>,
+    stop: Arc<AtomicBool>,
+}
+
+impl Test {
+    pub fn start(microphone: Option<String>, speaker: Option<String>) -> Result<Self> {
+        let stop = Arc::new(AtomicBool::new(false));
+        let cancelled = stop.clone();
+        let (progress, status) = mpsc::channel();
+        let selected = (microphone.clone(), speaker.clone());
+        std::thread::Builder::new()
+            .name("voxcord-microphone-test".into())
+            .spawn(move || {
+                let result = sample(
+                    microphone.as_deref(),
+                    speaker.as_deref(),
+                    &cancelled,
+                    &progress,
+                );
+                if !cancelled.load(Ordering::Acquire) {
+                    let _ = progress.send(match result {
+                        Ok(()) => return,
+                        Err(error) => Status::Failed(format!("{error:#}")),
+                    });
+                }
+            })?;
+        Ok(Self {
+            status,
+            microphone: selected.0,
+            speaker: selected.1,
+            stop,
+        })
+    }
+}
+
+impl Drop for Test {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+    }
+}
+
+fn sample(
+    microphone: Option<&str>,
+    speaker: Option<&str>,
+    stop: &AtomicBool,
+    status: &mpsc::Sender<Status>,
+) -> Result<()> {
+    let chunk = Duration::from_millis(20);
+    let mut input = Input::<i16>::open(microphone, "Voxcord — test micro", RATE, 1, chunk)
+        .context("Impossible d’ouvrir le microphone sélectionné")?;
+    let mut output =
+        Output::<i16>::open(speaker, "Voxcord — retour micro", RATE, 1, Some(chunk * 3))
+            .context("Impossible d’ouvrir la sortie audio sélectionnée")?;
+    let _ = status.send(Status::Monitoring);
+    let mut frame = [0; CHUNK];
+    while !stop.load(Ordering::Acquire) {
+        input
+            .read(&mut frame)
+            .context("Le microphone n’a pas fourni de son")?;
+        let gain = crate::volume::microphone() * crate::volume::speakers();
+        for sample in &mut frame {
+            *sample = (f32::from(*sample) * gain).clamp(-32768.0, 32767.0) as i16;
+        }
+        output
+            .write(&frame)
+            .context("La sortie audio a interrompu le test")?;
+    }
+    output.flush();
+    Ok(())
+}
