@@ -39,6 +39,67 @@ pub type Sink = Box<dyn FnMut(&I420<'_>) + Send>;
 /// The largest picture a camera gives, and how many a second: width,
 /// height, frames.
 pub type Size = (u32, u32, u32);
+const FIRST_FRAME_WAIT: Duration = Duration::from_secs(3);
+
+/// A settings preview owns its capture off the UI thread. Dropping it stops
+/// the preview without waiting for a camera driver on the UI thread.
+pub struct Preview {
+    pub feed: crate::picture::Feed,
+    pub error: std::sync::mpsc::Receiver<String>,
+    stop: Arc<AtomicBool>,
+}
+
+impl Preview {
+    pub fn start(id: Option<String>, size: (u32, u32)) -> Result<Self> {
+        let feed = crate::picture::Feed::new();
+        feed.show_at(Some(size));
+        let preview = feed.clone();
+        let (failed, error) = std::sync::mpsc::channel();
+        let stop = Arc::new(AtomicBool::new(false));
+        let cancelled = stop.clone();
+        std::thread::Builder::new().name("voxcord-camera-preview".into()).spawn(move || {
+            let mut reason = "La caméra a démarré sans envoyer d’image.".to_owned();
+            for size in [(WIDTH, HEIGHT, FPS), (640, 480, 30), (320, 240, 15)] {
+                if cancelled.load(Ordering::Acquire) { return; }
+                let (first, arrived) = std::sync::mpsc::sync_channel(1);
+                let mut paint = preview.sink();
+                let mut first = Some(first);
+                let sink: Sink = Box::new(move |picture| {
+                    paint(picture);
+                    if let Some(first) = first.take() { let _ = first.try_send(()); }
+                });
+                let camera = match Camera::open_at(id.as_deref(), size, sink) {
+                    Ok(camera) => camera,
+                    Err(error) => {
+                        reason = error.to_string();
+                        continue;
+                    }
+                };
+                let deadline = Instant::now() + FIRST_FRAME_WAIT;
+                while !cancelled.load(Ordering::Acquire) && Instant::now() < deadline {
+                    if arrived.recv_timeout(Duration::from_millis(80)).is_ok() {
+                        while !cancelled.load(Ordering::Acquire) {
+                            std::thread::sleep(Duration::from_millis(80));
+                        }
+                        drop(camera);
+                        return;
+                    }
+                }
+                drop(camera);
+            }
+            if !cancelled.load(Ordering::Acquire) {
+                let _ = failed.send(format!("{reason} Vérifie le périphérique et les autorisations caméra de Windows."));
+            }
+        })?;
+        Ok(Self { feed, error, stop })
+    }
+}
+
+impl Drop for Preview {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+    }
+}
 
