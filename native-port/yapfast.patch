--- /dev/null
+++ b/ui/personal-soundboard.html
@@ -0,0 +1,187 @@
+<!doctype html>
+<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#101117"><meta name="apple-mobile-web-app-capable" content="yes"><title>Voxcord · Soundboard</title>
