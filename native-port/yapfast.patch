diff --git a/src/ui/personal.rs b/src/ui/personal.rs
new file mode 100644
index 0000000..dad80ba
--- /dev/null
+++ b/src/ui/personal.rs
@@ -0,0 +1,805 @@
+//! The personal soundboard uses the native voice engine. Only the controller
+//! page is served over HTTP, for the PC and an explicitly paired phone.
+use std::{
+    cell::RefCell,
+    fs,
+    io::Read,
+    path::{Path, PathBuf},
+    rc::Weak,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        mpsc,
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+use serde_json::Value;
+use tokio::sync::mpsc as async_channel;
+use yapfast_core::{
+    network::Network,
+    personal_audio,
+    voice::{self, Command, Phase},
+};
+
+use crate::remote_server::{Board as BoardSnapshot, Service, Sound};
+
+use super::{
+    Adapter,
+    personal_hotkeys::{Action, Hotkeys},
+};
+
+type Result<T> = std::result::Result<T, String>;
+
+#[derive(Clone, Default, PartialEq)]
+struct AudioContext {
+    ready: bool,
+    speaker: Option<String>,
+}
+
+enum Request {
+    Voice(Command, mpsc::SyncSender<Result<()>>),
+    Shortcut(Action),
+    RefreshCatalog,
+}
+
+pub(super) struct PersonalBoard {
+    service: Arc<Service>,
+    directory: PathBuf,
+    settings: Mutex<BoardSnapshot>,
+    context: Mutex<AudioContext>,
+    commands: async_channel::Sender<Request>,
+    preview: Mutex<Option<Arc<AtomicBool>>>,
+    generation: AtomicU64,
+    downloads: Mutex<std::collections::HashMap<String, u64>>,
+    hotkeys: Mutex<Option<Hotkeys>>,
+    pressed: mpsc::SyncSender<Action>,
+    catalog_loaded: AtomicBool,
+    catalog_pending: AtomicBool,
+    recording_until: Mutex<Option<Instant>>,
+}
+
+impl PersonalBoard {
+    pub(super) fn start(root: &Path, adapter: Weak<RefCell<Adapter>>) -> Result<Arc<Self>> {
+        let directory = root.join("personal-sounds");
+        let mut settings: BoardSnapshot = fs::read(directory.join("library.json"))
+            .ok()
+            .and_then(|data| serde_json::from_slice(&data).ok())
+            .unwrap_or_default();
+        settings.sounds.retain(|sound| {
+            (sound.local && uuid::Uuid::parse_str(&sound.id).is_ok())
+                || (!sound.local && discord_id(&sound.id).is_some())
+        });
+        settings
+            .shortcuts
+            .entry("open".into())
+            .or_insert_with(|| "Ctrl+Alt+N".into());
+        settings.active = false;
+        settings.error.clear();
+        settings.last_playback.clear();
+        settings.recorded_shortcut.clear();
+        let (commands, mut incoming) = async_channel::channel(24);
+        let (pressed, hotkey_actions) = mpsc::sync_channel(8);
+        let board = Arc::new(Self {
+            service: Arc::new(Service::new()),
+            directory,
+            settings: Mutex::new(settings),
+            context: Mutex::default(),
+            commands,
+            preview: Mutex::default(),
+            generation: AtomicU64::default(),
+            downloads: Mutex::default(),
+            hotkeys: Mutex::default(),
+            pressed,
+            catalog_loaded: AtomicBool::new(false),
+            catalog_pending: AtomicBool::new(false),
+            recording_until: Mutex::default(),
+        });
+        slint::spawn_local(async move {
+            while let Some(request) = incoming.recv().await {
+                let Some(adapter) = adapter.upgrade() else {
+                    break;
+                };
+                if matches!(&request, Request::RefreshCatalog) {
+                    let adapter = adapter.borrow();
+                    if let Some(backend) = &adapter.backend {
+                        let sent = backend.send(yapfast_core::chat::Command::Discord(
+                            yapfast_core::chat::DiscordCommand::SoundCatalog,
+                        ));
+                        if sent.is_err() {
+                            if let Some(board) = &adapter.personal_board {
+                                board.update_catalog(&Err("Le moteur Discord est indisponible.".into()));
+                            }
+                        }
+                    } else if let Some(board) = &adapter.personal_board {
+                        board.update_catalog(&Err(
+                            "Connecte-toi à Discord pour charger tes serveurs.".into(),
+                        ));
+                    }
+                    continue;
+                }
+                let Request::Voice(command, ack) = request else {
+                    let Request::Shortcut(action) = request else {
+                        unreachable!()
+                    };
+                    if action == Action::OpenSettings {
+                        super::shell::open_settings(9);
+                        continue;
+                    }
+                    let window = adapter.borrow().window.upgrade();
+                    if let Some(window) = window {
+                        match action {
+                            Action::ToggleMute => window.invoke_toggle_mute(),
+                            Action::ToggleDeafen => window.invoke_toggle_deafen(),
+                            Action::ToggleVoiceMode => {
+                                window.set_input_mode(1 - window.get_input_mode());
+                                window.invoke_preferences_changed();
+                            }
+                            Action::ToggleStreamerMode => {
+                                window.set_streamer_mode(!window.get_streamer_mode());
+                                window.invoke_preferences_changed();
+                            }
+                            Action::OpenSettings => {
+                                window.set_settings_section(9);
+                                window.set_settings_open(true);
+                            }
+                            Action::ToggleCamera => window.invoke_toggle_camera(),
+                            Action::LeaveCall => window.invoke_leave_voice(),
+                            _ => unreachable!(),
+                        }
+                    } else {
+                        let mut adapter = adapter.borrow_mut();
+                        let voice = &adapter.app.state.voice;
+                        let command = match action {
+                            Action::ToggleMute => Some(Command::Mute(!voice.muted)),
+                            Action::ToggleDeafen => Some(Command::Deafen(!voice.deafened)),
+                            Action::ToggleCamera => Some(Command::Video(
+                                voice.camera_phase == voice::CameraPhase::Off,
+                            )),
+                            Action::LeaveCall => Some(Command::Leave),
+                            Action::ToggleVoiceMode => {
+                                adapter.layout.input_mode = if adapter.layout.input_mode
+                                    == super::InputMode::VoiceActivity
+                                {
+                                    super::InputMode::PushToTalk
+                                } else {
+                                    super::InputMode::VoiceActivity
+                                };
+                                yapfast_core::push_to_talk::set_on(
+                                    adapter.layout.input_mode == super::InputMode::PushToTalk,
+                                );
+                                adapter.sync_talk_key();
+                                None
+                            }
+                            Action::ToggleStreamerMode => {
+                                adapter.layout.streamer_mode = !adapter.layout.streamer_mode;
+                                None
+                            }
+                            _ => unreachable!(),
+                        };
+                        if let Some(command) = command {
+                            let effects = adapter.app.dispatch(super::Action::Voice(command));
+                            adapter.execute(effects);
+                            adapter.show_tray();
+                        } else {
+                            adapter.layout.write(&adapter.root);
+                        }
+                    }
+                    continue;
+                };
+                let adapter = adapter.borrow();
+                let result = if matches!(&command, Command::PersonalSound(..))
+                    && !can_send(&adapter.app.state.voice)
+                {
+                    Err("Rejoins un appel Discord et ouvre ton microphone.".into())
+                } else {
+                    match &adapter.backend {
+                        Some(backend) => backend
+                            .send(yapfast_core::chat::Command::Voice(command))
+                            .map_err(|_| "La connexion vocale a changé.".into()),
+                        None => Err("Connecte-toi à Discord dans Voxcord.".into()),
+                    }
+                };
+                let _ = ack.send(result);
+            }
+        })
+        .map_err(|error| error.to_string())?;
+        let weak = Arc::downgrade(&board);
+        thread::Builder::new()
+            .name("voxcord-hotkey-actions".into())
+            .spawn(move || {
+                while let Ok(action) = hotkey_actions.recv() {
+                    let Some(board) = weak.upgrade() else { break };
+                    if board
+                        .recording_until
+                        .lock()
+                        .unwrap()
+                        .is_some_and(|until| Instant::now() < until)
+                    {
+                        let mut settings = board.settings.lock().unwrap();
+                        if let Some((key, _)) = Self::bindings(&settings)
+                            .into_iter()
+                            .find(|(_, candidate)| *candidate == action)
+                        {
+                            settings.recorded_shortcut = key;
+                        }
+                        drop(settings);
+                        board.sync();
+                        continue;
+                    }
+                    let result = match action {
+                        Action::Play(id) => board.play_saved(&id, false),
+                        Action::StopSounds => board.stop(),
+                        Action::OpenBoard => board.open(),
+                        _ => {
+                            let _ = board.commands.try_send(Request::Shortcut(action));
+                            continue;
+                        }
+                    };
+                    board.settings.lock().unwrap().error = result.err().unwrap_or_default();
+                    board.sync();
+                }
+            })
+            .map_err(|error| error.to_string())?;
+        {
+            let mut settings = board.settings.lock().unwrap();
+            match board.register_hotkeys(&settings) {
+                Ok(hotkeys) => *board.hotkeys.lock().unwrap() = hotkeys,
+                Err(error) => settings.error = error,
+            }
+        }
+        board.sync();
+        Ok(board)
+    }
+
+    pub(super) fn open(self: &Arc<Self>) -> Result<()> {
+        self.request_catalog();
+        let board = Arc::downgrade(self);
+        let url = self.service.start(Arc::new(move |value| {
+            let board = board.upgrade().ok_or("Voxcord a été fermé.")?;
+            if value["action"] == "network-access" {
+                return network_access(board.service.port());
+            }
+            let result = board.handle(&value);
+            board.sync();
+            if let Some(request) = value["requestId"].as_str() {
+                board.service.complete(request, result.err());
+            }
+            Ok(())
+        }))?;
+        webbrowser::open(&url).map_err(|error| error.to_string())
+    }
+
+    pub(super) fn update_voice(&self, voice: &voice::State) {
+        let updated = AudioContext {
+            ready: can_send(voice),
+            speaker: voice.speaker.clone(),
+        };
+        let mut context = self.context.lock().unwrap();
+        if *context == updated {
+            return;
+        }
+        if context.ready && !updated.ready {
+            self.invalidate_playback();
+        }
+        *context = updated;
+        drop(context);
+        self.sync();
+    }
+
+    fn sync(&self) {
+        let mut view = self.settings.lock().unwrap().clone();
+        if !self.catalog_loaded.load(Ordering::Acquire) {
+            view.sounds.retain(|sound| sound.local);
+        }
+        view.active = self.context.lock().unwrap().ready;
+        if let Err(error) = self.service.sync(view) {
+            tracing::warn!(%error, "personal soundboard state could not be updated");
+        }
+    }
+
+    fn request_catalog(&self) {
+        if !self.catalog_pending.swap(true, Ordering::AcqRel)
+            && self.commands.try_send(Request::RefreshCatalog).is_err()
+        {
+            self.catalog_pending.store(false, Ordering::Release);
+        }
+    }
+
+    pub(super) fn update_catalog(
+        &self,
+        catalog: &std::result::Result<Arc<[voice::SoundGroup]>, String>,
+    ) {
+        self.catalog_pending.store(false, Ordering::Release);
+        let mut settings = self.settings.lock().unwrap();
+        match catalog {
+            Ok(groups) => {
+                let previous: std::collections::HashMap<_, _> = settings
+                    .sounds
+                    .iter()
+                    .filter(|sound| !sound.local)
+                    .map(|sound| (sound.id.clone(), sound.clone()))
+                    .collect();
+                settings.sounds.retain(|sound| sound.local);
+                let mut ids = std::collections::HashSet::new();
+                for group in groups.iter().rev() {
+                    for sound in &group.sounds {
+                        let id = format!("discord:{}", sound.id);
+                        if discord_id(&id).is_none() || !ids.insert(id.clone()) {
+                            continue;
+                        }
+                        if settings.sounds.len() >= 5000 {
+                            break;
+                        }
+                        settings
+                            .sounds
+                            .push(previous.get(&id).cloned().unwrap_or_else(|| Sound {
+                                id,
+                                name: sound.name.clone(),
+                                local: false,
+                                favorite: sound.favorite,
+                                category: group.name.clone(),
+                                color: "#7c6bff".into(),
+                                ..Sound::default()
+                            }));
+                    }
+                }
+                self.catalog_loaded.store(true, Ordering::Release);
+                settings.error.clear();
+                if let Err(error) = self.save(&settings) {
+                    settings.error = error;
+                }
+            }
+            Err(error) => settings.error = format!("Catalogue Discord : {error}"),
+        }
+        drop(settings);
+        self.sync();
+    }
+
+    fn voice(&self, command: Command) -> Result<()> {
+        let (done, result) = mpsc::sync_channel(1);
+        self.commands
+            .try_send(Request::Voice(command, done))
+            .map_err(|_| "Le moteur vocal est indisponible.")?;
+        result
+            .recv_timeout(Duration::from_secs(2))
+            .map_err(|_| "Le moteur vocal n’a pas répondu.")?
+    }
+
+    fn stop_preview(&self) {
+        if let Some(stop) = self.preview.lock().unwrap().take() {
+            stop.store(true, Ordering::Release);
+        }
+    }
+
+    fn invalidate_playback(&self) {
+        self.generation.fetch_add(1, Ordering::AcqRel);
+        self.downloads.lock().unwrap().clear();
+        self.stop_preview();
+    }
+
+    fn stop(&self) -> Result<()> {
+        self.invalidate_playback();
+        let active = self.context.lock().unwrap().ready;
+        if active {
+            self.voice(Command::StopPersonalSounds)?;
+        }
+        self.settings.lock().unwrap().last_playback = "Lecture arrêtée.".into();
+        Ok(())
+    }
+
+    fn bindings(settings: &BoardSnapshot) -> Vec<(String, Action)> {
+        let global = [
+            ("mute", Action::ToggleMute),
+            ("deafen", Action::ToggleDeafen),
+            ("voice-mode", Action::ToggleVoiceMode),
+            ("streamer", Action::ToggleStreamerMode),
+            ("settings", Action::OpenSettings),
+            ("open", Action::OpenBoard),
+            ("camera", Action::ToggleCamera),
+            ("leave", Action::LeaveCall),
+            ("stop", Action::StopSounds),
+        ];
+        global
+            .into_iter()
+            .filter_map(|(id, action)| {
+                settings
+                    .shortcuts
+                    .get(id)
+                    .filter(|key| !key.is_empty())
+                    .map(|key| (key.clone(), action))
+            })
+            .chain(
+                settings
+                    .sounds
+                    .iter()
+                    .filter(|sound| !sound.shortcut.is_empty())
+                    .map(|sound| (sound.shortcut.clone(), Action::Play(sound.id.clone()))),
+            )
+            .collect()
+    }
+
+    fn register_hotkeys(&self, settings: &BoardSnapshot) -> Result<Option<Hotkeys>> {
+        Hotkeys::register(Self::bindings(settings), self.pressed.clone())
+    }
+
+    fn start_preview(
+        &self,
+        samples: Arc<[i16]>,
+        speaker: Option<String>,
+        volume: f32,
+    ) -> Result<()> {
+        self.stop_preview();
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let stop = cancelled.clone();
+        thread::Builder::new()
+            .name("voxcord-personal-preview".into())
+            .spawn(move || {
+                if let Err(error) =
+                    personal_audio::preview(&samples, speaker.as_deref(), volume, &stop)
+                {
+                    tracing::warn!(%error, "personal sound preview failed");
+                }
+            })
+            .map_err(|error| error.to_string())?;
+        *self.preview.lock().unwrap() = Some(cancelled);
+        Ok(())
+    }
+
+    fn play(&self, name: &str, samples: Arc<[i16]>, preview: bool, generation: u64) -> Result<()> {
+        let context = self.context.lock().unwrap().clone();
+        let settings = self.settings.lock().unwrap();
+        let (enabled, volume, monitor, monitor_volume) = (
+            settings.enabled,
+            settings.volume as f32,
+            settings.monitor,
+            settings.monitor_volume as f32,
+        );
+        drop(settings);
+        if generation != self.generation.load(Ordering::Acquire) {
+            return Err("Lecture annulée.".into());
+        }
+        if !preview {
+            if !enabled {
+                return Err("Active le mixeur avant d’envoyer un son.".into());
+            }
+            if !context.ready {
+                return Err("Rejoins un appel Discord et ouvre ton microphone.".into());
+            }
+            self.voice(Command::PersonalSound(samples.clone(), volume))?;
+        }
+        if preview || monitor {
+            self.start_preview(samples, context.speaker, monitor_volume)?;
+        }
+        self.settings.lock().unwrap().last_playback = if preview {
+            format!("Écoute locale · {name}")
+        } else {
+            format!("Dans l’appel · {name}")
+        };
+        Ok(())
+    }
+
+    fn clip_path(&self, id: &str) -> PathBuf {
+        self.directory.join(format!("{id}.audio"))
+    }
+
+    fn import(&self, name: &str, data: &[u8], slug: &str, color: &str) -> Result<()> {
+        personal_audio::decode(data).map_err(|error| format!("{error:#}"))?;
+        let mut settings = self.settings.lock().unwrap();
+        if !slug.is_empty()
+            && settings
+                .sounds
+                .iter()
+                .any(|sound| sound.source_slug == slug)
+        {
+            return Ok(());
+        }
+        if settings.sounds.iter().filter(|sound| sound.local).count() >= 500 {
+            return Err("500 sons maximum.".into());
+        }
+        let id = uuid::Uuid::new_v4().simple().to_string();
+        let path = self.clip_path(&id);
+        fs::create_dir_all(&self.directory).map_err(io_message)?;
+        fs::write(&path, data).map_err(io_message)?;
+        let mut updated = settings.clone();
+        updated.sounds.push(Sound {
+            id,
+            name: clean(name, 160),
+            local: true,
+            favorite: false,
+            category: if slug.is_empty() {
+                String::new()
+            } else {
+                "Myinstants".into()
+            },
+            color: clean(color, 7),
+            shortcut: String::new(),
+            source_slug: clean(slug, 160),
+        });
+        if let Err(error) = self.save(&updated) {
+            let _ = fs::remove_file(path);
+            return Err(error);
+        }
+        *settings = updated;
+        Ok(())
+    }
+
+    fn save(&self, settings: &BoardSnapshot) -> Result<()> {
+        fs::create_dir_all(&self.directory).map_err(io_message)?;
+        let pending = self.directory.join("library.json.tmp");
+        let data = serde_json::to_vec(settings).map_err(|error| error.to_string())?;
+        fs::write(&pending, data).map_err(io_message)?;
+        fs::rename(pending, self.directory.join("library.json")).map_err(io_message)
+    }
+
+    fn handle(&self, value: &Value) -> Result<()> {
+        let field = |name: &str| value[name].as_str().unwrap_or("");
+        match field("action") {
+            "import" => {
+                let data = self.service.take_upload(field("upload_id"))?;
+                let name = percent_encoding::percent_decode_str(field("name")).decode_utf8_lossy();
+                self.import(&name, &data, "", "")
+            }
+            "online-prepare" => {
+                let mut pending = self.downloads.lock().unwrap();
+                if pending.len() >= 8 {
+                    pending.clear();
+                }
+                pending.insert(
+                    field("token").into(),
+                    self.generation.load(Ordering::Acquire),
+                );
+                Ok(())
+            }
+            "online-sound" => {
+                let data = self.service.take_upload(field("upload_id"))?;
+                if field("mode") == "save" {
+                    return self.import(field("name"), &data, field("slug"), field("color"));
+                }
+                let generation = self
+                    .downloads
+                    .lock()
+                    .unwrap()
+                    .remove(field("token"))
+                    .ok_or("Lecture annulée.")?;
+                self.play(
+                    field("name"),
+                    personal_audio::decode(&data).map_err(|error| format!("{error:#}"))?,
+                    field("mode") == "preview",
+                    generation,
+                )
+            }
+            "play" | "preview" => self.play_saved(field("id"), field("action") == "preview"),
+            "stop" => self.stop(),
+            "refresh" => {
+                self.request_catalog();
+                Ok(())
+            }
+            "record-shortcut" => {
+                let enabled = value["enabled"].as_bool().ok_or("État invalide.")?;
+                *self.recording_until.lock().unwrap() =
+                    enabled.then(|| Instant::now() + Duration::from_secs(30));
+                self.settings.lock().unwrap().recorded_shortcut.clear();
+                Ok(())
+            }
+            "enable" | "volume" | "monitor" | "monitor-volume" | "edit" | "delete" | "shortcut" => {
+                self.edit(value, field("action"), field("id"))
+            }
+            _ => Err("Commande inconnue.".into()),
+        }
+    }
+
+    fn play_saved(&self, id: &str, preview: bool) -> Result<()> {
+        let generation = self.generation.load(Ordering::Acquire);
+        let name = self
+            .settings
+            .lock()
+            .unwrap()
+            .sounds
+            .iter()
+            .find(|sound| sound.id == id)
+            .map(|sound| sound.name.clone())
+            .ok_or("Son introuvable.")?;
+        let mut data = Vec::new();
+        if let Some(sound) = discord_id(id) {
+            if !self.catalog_loaded.load(Ordering::Acquire) {
+                return Err("Actualise le catalogue Discord avant de jouer ce son.".into());
+            }
+            let response = reqwest::blocking::Client::builder()
+                .timeout(Duration::from_secs(12))
+                .build()
+                .map_err(|error| error.to_string())?
+                .get(format!(
+                    "https://cdn.discordapp.com/soundboard-sounds/{sound}"
+                ))
+                .send()
+                .and_then(|response| response.error_for_status())
+                .map_err(|error| error.to_string())?;
+            response
+                .take((personal_audio::MAX_BYTES + 1) as u64)
+                .read_to_end(&mut data)
+                .map_err(io_message)?;
+        } else {
+            fs::File::open(self.clip_path(id))
+                .map_err(io_message)?
+                .take((personal_audio::MAX_BYTES + 1) as u64)
+                .read_to_end(&mut data)
+                .map_err(io_message)?;
+        }
+        let decoded = personal_audio::decode(&data).map_err(|error| format!("{error:#}"))?;
+        self.play(&name, decoded, preview, generation)
+    }
+
+    fn edit(&self, value: &Value, action: &str, id: &str) -> Result<()> {
+        let mut settings = self.settings.lock().unwrap();
+        let mut updated = settings.clone();
+        let mut deleted = None;
+        match action {
+            "enable" => updated.enabled = value["enabled"].as_bool().ok_or("État invalide.")?,
+            "monitor" => updated.monitor = value["enabled"].as_bool().ok_or("État invalide.")?,
+            "shortcut" => {
+                if !matches!(
+                    id,
+                    "mute"
+                        | "deafen"
+                        | "voice-mode"
+                        | "streamer"
+                        | "settings"
+                        | "open"
+                        | "camera"
+                        | "leave"
+                        | "stop"
+                ) {
+                    return Err("Raccourci inconnu.".into());
+                }
+                let key = value["key"].as_str().ok_or("Raccourci invalide.")?;
+                updated.shortcuts.insert(id.into(), clean(key, 40));
+            }
+            "volume" | "monitor-volume" => {
+                let volume = value["volume"]
+                    .as_f64()
+                    .filter(|value| (0.0..=1.0).contains(value))
+                    .ok_or("Volume invalide.")?;
+                if action == "volume" {
+                    updated.volume = volume;
+                } else {
+                    updated.monitor_volume = volume;
+                }
+            }
+            "edit" | "delete" => {
+                let index = updated
+                    .sounds
+                    .iter()
+                    .position(|sound| sound.id == id)
+                    .ok_or("Son introuvable.")?;
+                if action == "delete" {
+                    deleted = Some(updated.sounds.remove(index).id);
+                } else {
+                    let sound = &mut updated.sounds[index];
+                    if let Some(name) = value["name"].as_str() {
+                        sound.name = clean(name, 160);
+                    }
+                    if let Some(category) = value["category"].as_str() {
+                        sound.category = clean(category, 48);
+                    }
+                    if let Some(color) = value["color"].as_str() {
+                        sound.color = clean(color, 7);
+                    }
+                    if let Some(favorite) = value["favorite"].as_bool() {
+                        sound.favorite = favorite;
+                    }
+                    if let Some(shortcut) = value["shortcut"].as_str() {
+                        sound.shortcut = clean(shortcut, 40);
+                    }
+                }
+            }
+            _ => return Err("Réglage inconnu.".into()),
+        }
+        let hotkeys_changed =
+            action == "shortcut" || deleted.is_some() || value["shortcut"].is_string();
+        if hotkeys_changed {
+            let mut hotkeys = self.hotkeys.lock().unwrap();
+            drop(hotkeys.take());
+            match self.register_hotkeys(&updated).and_then(|candidate| {
+                updated.error.clear();
+                self.save(&updated)?;
+                Ok(candidate)
+            }) {
+                Ok(candidate) => *hotkeys = candidate,
+                Err(error) => {
+                    *hotkeys = self.register_hotkeys(&settings).unwrap_or_else(|restore| {
+                        settings.error = restore;
+                        None
+                    });
+                    return Err(error);
+                }
+            }
+        } else {
+            self.save(&updated)?;
+        }
+        let stopping =
+            (settings.enabled && !updated.enabled) || (settings.monitor && !updated.monitor);
+        let stop_call = settings.enabled && !updated.enabled;
+        *settings = updated;
+        drop(settings);
+        if let Some(id) = deleted {
+            let _ = fs::remove_file(self.clip_path(&id));
+        }
+        if stopping {
+            self.invalidate_playback();
+        }
+        let active = self.context.lock().unwrap().ready;
+        if stop_call && active {
+            self.voice(Command::StopPersonalSounds)?;
+        }
+        Ok(())
+    }
+}
+
+impl Drop for PersonalBoard {
+    fn drop(&mut self) {
+        self.invalidate_playback();
+        self.service.shutdown();
+    }
+}
+
+fn can_send(voice: &voice::State) -> bool {
+    voice.phase == Phase::Connected
+        && voice
+            .room
+            .as_deref()
+            .is_some_and(|id| Network::of(id) == Network::Discord)
+        && !voice.muted
+        && !voice.deafened
+        && !voice
+            .participants
+            .iter()
+            .any(|person| person.local && person.server_muted)
+}
+
+fn discord_id(id: &str) -> Option<&str> {
+    id.strip_prefix("discord:").filter(|id| {
+        !id.is_empty() && id.len() <= 24 && id.bytes().all(|byte| byte.is_ascii_digit())
+    })
+}
+
+fn clean(value: &str, maximum: usize) -> String {
+    value
+        .trim()
+        .chars()
+        .filter(|character| !character.is_control())
+        .take(maximum)
+        .collect()
+}
+
+fn io_message(error: std::io::Error) -> String {
+    format!("Bibliothèque de sons : {error}")
+}
+
+fn network_access(port: u16) -> Result<()> {
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        let executable = std::env::current_exe().map_err(io_message)?;
+        let path = executable.to_str().ok_or("Chemin de Voxcord invalide.")?;
+        let arguments = format!(
+            "advfirewall firewall add rule name=\"Voxcord Soundboard\" dir=in action=allow protocol=TCP localport={port} program=\"{path}\" profile=private remoteip=LocalSubnet"
+        );
+        let script = format!(
+            "Start-Process -FilePath \"$env:SystemRoot\\System32\\netsh.exe\" -WindowStyle Hidden -Verb RunAs -ArgumentList '{}'",
+            arguments.replace('\'', "''")
+        );
+        std::process::Command::new("powershell.exe")
+            .args(["-NoProfile", "-NonInteractive", "-Command", &script])
+            .creation_flags(0x08000000)
+            .spawn()
+            .map(|_| ())
+            .map_err(io_message)
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = port;
+        Err("Autorise ce port sur le pare-feu pour le réseau local privé.".into())
+    }
+}
