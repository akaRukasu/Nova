index 0000000..952520b
--- /dev/null
+++ b/crates/yapfast-core/src/microphone_test.rs
@@ -0,0 +1,75 @@
+//! Records a short microphone sample in memory, then plays it locally.
+use std::{
+    sync::{Arc, atomic::{AtomicBool, Ordering}, mpsc},
+    time::Duration,
+};
+
+use anyhow::{Context, Result};
+
+use crate::audio_io::{Input, Output, RATE};
+
+const CHUNK: usize = RATE as usize / 50;
+const SAMPLE_CHUNKS: usize = 150;
+
+pub enum Status {
+    Recording,
+    Playing,
+    Finished,
+    Failed(String),
+}
+
+pub struct Test {
+    pub status: mpsc::Receiver<Status>,
+    stop: Arc<AtomicBool>,
+}
+
+impl Test {
+    pub fn start(microphone: Option<String>, speaker: Option<String>) -> Result<Self> {
+        let stop = Arc::new(AtomicBool::new(false));
+        let cancelled = stop.clone();
+        let (progress, status) = mpsc::channel();
+        std::thread::Builder::new().name("voxcord-microphone-test".into()).spawn(move || {
+            let result = sample(microphone.as_deref(), speaker.as_deref(), &cancelled, &progress);
+            if !cancelled.load(Ordering::Acquire) {
+                let _ = progress.send(match result {
+                    Ok(()) => Status::Finished,
+                    Err(error) => Status::Failed(format!("{error:#}")),
+                });
+            }
+        })?;
+        Ok(Self { status, stop })
+    }
+}
+
+impl Drop for Test {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+    }
+}
+
+fn sample(
+    microphone: Option<&str>,
+    speaker: Option<&str>,
+    stop: &AtomicBool,
+    status: &mpsc::Sender<Status>,
+) -> Result<()> {
+    let chunk = Duration::from_millis(20);
+    let mut input = Input::<i16>::open(microphone, "Voxcord — test micro", RATE, 1, chunk)
+        .context("Impossible d’ouvrir le microphone sélectionné")?;
+    let _ = status.send(Status::Recording);
+    let mut recording = vec![0; SAMPLE_CHUNKS * CHUNK];
+    for frame in recording.chunks_exact_mut(CHUNK) {
+        if stop.load(Ordering::Acquire) { return Ok(()); }
+        input.read(frame).context("Le microphone n’a pas fourni de son")?;
+    }
+    drop(input);
+    if stop.load(Ordering::Acquire) { return Ok(()); }
+    let mut output = Output::<i16>::open(speaker, "Voxcord — retour micro", RATE, 1, Some(chunk * 3))
+        .context("Impossible d’ouvrir la sortie audio sélectionnée")?;
+    let _ = status.send(Status::Playing);
+    for frame in recording.chunks_exact(CHUNK) {
+        if stop.load(Ordering::Acquire) { return Ok(()); }
+        output.write(frame).context("La sortie audio a interrompu le test")?;
+    }
+    output.drain().context("La sortie audio a interrompu le test")
+}
