+    time::Duration,
+};
+
+use anyhow::{Context, Result, ensure};
+
+use crate::{
+    audio_io::{Output, RATE},
+    soundboard,
+};
+
+pub const MAX_BYTES: usize = 8 * 1024 * 1024;
+const MAX_SECONDS: usize = 30;
+
+pub fn decode(data: &[u8]) -> Result<Arc<[i16]>> {
+    ensure!(
+        !data.is_empty() && data.len() <= MAX_BYTES,
+        "Le fichier doit faire entre 1 octet et 8 Mo."
+    );
+    let stereo =
+        soundboard::decode_bounded(data, MAX_SECONDS).context("Fichier audio illisible")?;
+    Ok(stereo
+        .chunks_exact(2)
+        .map(|frame| ((i32::from(frame[0]) + i32::from(frame[1])) / 2) as i16)
+        .collect())
+}
+
+pub fn preview(
+    samples: &[i16],
+    speaker: Option<&str>,
+    volume: f32,
+    stop: &AtomicBool,
+) -> Result<()> {
+    let block = Duration::from_millis(20);
+    let mut output = Output::<i16>::open(
+        speaker,
+        "Voxcord — écoute de la soundboard",
+        RATE,
+        1,
+        Some(block * 3),
+    )?;
+    let mut frame = [0; RATE as usize / 50];
+    for next in samples.chunks(frame.len()) {
+        if stop.load(Ordering::Acquire) {
+            output.flush();
+            return Ok(());
+        }
+        for (out, input) in frame.iter_mut().zip(next) {
+            *out = (f32::from(*input) * volume.clamp(0.0, 1.0)) as i16;
+        }
+        output.write(&frame[..next.len()])?;
+    }
+    output.drain()
+}
