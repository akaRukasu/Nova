+        assert_eq!(request(&service, "GET", "/api/state", "", b"", None).0, 401);
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/myinstants/search",
+                "",
+                br#"{"query":"test"}"#,
+                None
+            )
+            .0,
+            401
+        );
+        assert_eq!(
+            request(&service, "GET", "/api/state", &desktop, b"", None).0,
+            200
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/remote",
+                &desktop,
+                br#"{"enabled":true}"#,
+                Some("http://evil.invalid")
+            )
+            .0,
+            403
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/remote",
+                &desktop,
+                br#"{"enabled":true}"#,
+                None
+            )
+            .0,
+            200
+        );
+        let phone = service.data.lock().unwrap().phone_key.clone();
+        let state: Value =
+            serde_json::from_str(&request(&service, "GET", "/api/state", &phone, b"", None).1)
+                .unwrap();
+        assert_eq!(state["desktop"], false);
+        assert!(state.get("remote").is_none());
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/command",
+                &phone,
+                br#"{"action":"play","id":"test-sound"}"#,
+                None
+            )
+            .0,
+            200
+        );
+        assert_eq!(calls.lock().unwrap()[0]["id"], "test-sound");
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/command",
+                &phone,
+                br#"{"action":"play","id":"missing"}"#,
+                None
+            )
+            .0,
+            409
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/command",
+                &phone,
+                br#"{"action":"volume","volume":3}"#,
+                None
+            )
+            .0,
+            409
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/command",
+                &phone,
+                br#"{"action":"preview","id":"test-sound"}"#,
+                None
+            )
+            .0,
+            403
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/command",
+                &phone,
+                br#"{"action":"monitor","enabled":true}"#,
+                None
+            )
+            .0,
+            403
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/command",
+                &phone,
+                br#"{"action":"monitor-volume","volume":0.2}"#,
+                None
+            )
+            .0,
+            403
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/command",
+                &phone,
+                br#"{"action":"online-sound"}"#,
+                None
+            )
+            .0,
+            403
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/myinstants/search",
+                &phone,
+                br#"{"query":"x"}"#,
+                None
+            )
+            .0,
+            400
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/myinstants/audio",
+                &phone,
+                br#"{"slug":"unknown"}"#,
+                None
+            )
+            .0,
+            404
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/command",
+                &desktop,
+                br#"{"action":"monitor-volume","volume":2}"#,
+                None
+            )
+            .0,
+            409
+        );
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/remote",
+                &phone,
+                br#"{"enabled":false}"#,
+                None
+            )
+            .0,
+            403
+        );
+        assert_eq!(
+            request(&service, "POST", "/api/network-access", &phone, b"", None).0,
+            403
+        );
+        assert_eq!(
+            request(&service, "POST", "/api/upload", &desktop, b"RIFFtest", None).0,
+            200
+        );
+        assert!(service.uploads.lock().unwrap().is_empty());
+        assert_eq!(
+            request(
+                &service,
+                "POST",
+                "/api/remote",
+                &desktop,
+                br#"{"enabled":false}"#,
+                None
+            )
+            .0,
+            200
+        );
+        assert_eq!(
+            request(&service, "GET", "/api/state", &phone, b"", None).0,
+            401
+        );
+        service.shutdown();
+    }
+}
