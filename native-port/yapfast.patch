--- /dev/null
+++ b/src/ui/language.rs
@@ -0,0 +1,32 @@
+use std::{
+    collections::BTreeMap,
+    sync::{
+        OnceLock,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+static FRENCH: AtomicBool = AtomicBool::new(true);
+static TRANSLATIONS: OnceLock<BTreeMap<String, String>> = OnceLock::new();
+
+pub(super) fn select(locale: &str) {
+    let french = locale != "en";
+    FRENCH.store(french, Ordering::Relaxed);
+    // Slint identifies the original, untranslated catalogue with an empty name.
+    if let Err(error) = slint::select_bundled_translation(if french { "fr" } else { "" }) {
+        tracing::warn!(%error, "could not select the interface language");
+    }
+}
+
+pub(super) fn tr(text: &str) -> &str {
+    if !FRENCH.load(Ordering::Relaxed) {
+        return text;
+    }
+    TRANSLATIONS
+        .get_or_init(|| {
+            serde_json::from_str(include_str!("../../ui/translations/fr.json"))
+                .expect("the bundled French catalogue is valid")
+        })
+        .get(text)
+        .map_or(text, String::as_str)
+}
