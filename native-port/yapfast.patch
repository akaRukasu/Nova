+fn server_voice_summary(
+    server: &yapfast_core::chat::ChatServer,
+    rooms_by_id: &HashMap<&str, &yapfast_core::chat::ChatRoom>,
+) -> SharedString {
+    if !server.discord || server.unavailable { return SharedString::default(); }
+    let mut lines = Vec::new();
+    let mut participants = 0;
+    let mut shown = 0;
+    for room in server.channels.iter().filter_map(|id| rooms_by_id.get(id.as_str())) {
+        if !room.voice || room.locked || room.people.is_empty() { continue; }
+        participants += room.people.len();
+        if lines.len() >= 4 || shown >= 10 { continue; }
+        let names: Vec<_> = room.people.iter().take((10 - shown).min(3)).map(|person| {
+            let name = person.name.chars().take(32).collect::<String>();
+            match (person.video, person.streaming) {
+                (true, true) => format!("{name} (caméra, live)"),
+                (true, false) => format!("{name} (caméra)"),
+                (false, true) => format!("{name} (live)"),
+                _ => name,
+            }
+        }).collect();
+        shown += names.len();
+        let channel = room.name.chars().take(38).collect::<String>();
+        lines.push(format!("#{channel} : {}", names.join(", ")));
+    }
+    if lines.is_empty() { return SharedString::default(); }
+    if participants > shown { lines.push(format!("+{} en vocal", participants - shown)); }
+    format!("\n{}", lines.join("\n")).into()
+}
